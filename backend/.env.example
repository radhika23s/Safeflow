# Horizon — Autonomous Financial Crime Investigation System
# Environment Variables — NEVER commit this file to git

# ============================================================
# LLM API — copy this file to `.env` and fill in your real key.
# uvicorn loads backend/.env via python-dotenv at startup.
# Get a key: https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# Database
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./horizon.db

# ============================================================
# App Config
# ============================================================
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080

# ============================================================
# RAG / ChromaDB
# ============================================================
CHROMA_PERSIST_DIR=./chroma_db
RAG_DOCS_DIR=./rag_docs
