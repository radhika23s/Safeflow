# =============================================================================
# Safe Flow — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & Environment Variables
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
backend/.env
# Keep the example file so team knows what vars are needed
!backend/.env.example

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
.eggs/
dist/
build/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# mypy / ruff / pyright
.mypy_cache/
.ruff_cache/
pyrightconfig.json

# -----------------------------------------------------------------------------
# ML Models & Large Binary Files  (commit configs/metadata, not binaries)
# -----------------------------------------------------------------------------
*.pkl
!backend/fraud_model.pkl
*.joblib
*.h5
*.model
*.bin
*.onnx
# XGBoost model binary
# fraud_model.pkl � included in repo (only 1MB)
backend/models/
# smarthoriagent trained artifacts
smarthoriagent/models/isolation_forest/*.pkl
smarthoriagent/models/random_forest/*.pkl
smarthoriagent/models/xgboost/model.*
# But keep metadata and feature name JSON files
!smarthoriagent/models/**/*.json
!smarthoriagent/models/**/*.csv

# -----------------------------------------------------------------------------
# Database  (SQLite is runtime state, not source)
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/horizon.db

# ChromaDB vector store
chroma_db/
chromadb/

# -----------------------------------------------------------------------------
# Node / Frontend (Vite)
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
out/
# Vite build output
frontend/dist/
dist/

# Frontend env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# OS & IDE
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Temporary review clone (used during branch analysis)
graph_agent_review/

# Large raw dataset files, notebooks, research & downloads
backend/drivematerial/
drive-download*/
ML/
Research/

# Generic large binary/data formats
*.csv.gz
*.parquet

.output/
.wrangler/
.vercel/
frontend/.output/
frontend/.wrangler/
frontend/.vercel/

# Internal sprint, review & evaluator markdown documents
EVALUATOR_CONCERNS_AND_FIXES.md
frontend/AGENTS.md
frontend/src/routes/README.md
horizon2_audit_and_test_plan.md
implementation_plan.md
PROJECT_STATUS_AND_MERGE_SUMMARY.md
walkthrough.md
HACKATHON_DEMO_AND_LEDGER_UI_PLAN.md
SAFE_FLOW_34HR_IMPLEMENTATION_PLAN.md

# Ledger
ledger/node_modules/
ledger/.env
ledger/README.md